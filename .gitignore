.runtime/
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
# Original input PDFs are preserved locally; canonical copies are in assets/.
resources/
# Large public source datasets can be reacquired with scripts/acquire_context.py.
assets/data/context/*.tif
assets/data/context/*.osm.pbf
# Regenerable TOPSAR intermediate and geocoded rasters.
assets/data/context/topsar/*.tif
# Restricted Archaeoscape inputs AND parcel-derived outputs stay local.
private_data/
private_outputs/

# Restricted survey downloads: never commit.
assets/private/
